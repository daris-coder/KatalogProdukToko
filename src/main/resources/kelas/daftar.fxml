<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.DaftarController">
    <top>
        <VBox spacing="12" styleClass="header">
            <Label text="Katalog Produk Toko" styleClass="title"/>
            <HBox spacing="10">
                <TextField fx:id="cariField" promptText="Cari berdasarkan nama produk" onAction="#cari" HBox.hgrow="ALWAYS"/>
                <Button text="Cari" onAction="#cari"/>
                <Button text="Tambah Produk" onAction="#tambah" styleClass="button-primary"/>
                <Button text="Lihat Detail" onAction="#detail"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tabel">
            <columns>
                <TableColumn fx:id="kodeCol" text="Kode" prefWidth="120"/>
                <TableColumn fx:id="namaCol" text="Nama Produk" prefWidth="290"/>
                <TableColumn fx:id="kategoriCol" text="Kategori" prefWidth="170"/>
                <TableColumn fx:id="hargaCol" text="Harga" prefWidth="180"/>
            </columns>
        </TableView>
    </center>
    <bottom><Label fx:id="pesanLabel" styleClass="message"/></bottom>
</BorderPane>
