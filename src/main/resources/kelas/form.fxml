<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.FormController">
    <top><HBox spacing="16" styleClass="header"><Label text="Tambah Produk" styleClass="title"/><Button text="Lihat Daftar" onAction="#bukaDaftar"/></HBox></top>
    <center>
        <VBox spacing="12" styleClass="page">
            <VBox spacing="10" styleClass="card">
                <Label text="Kode produk"/><TextField fx:id="kodeField" promptText="Contoh: PRD001"/>
                <Label text="Nama produk"/><TextField fx:id="namaField" promptText="Contoh: Nasi Goreng"/>
                <Label text="Kategori"/><ComboBox fx:id="kategoriBox" maxWidth="Infinity"/>
                <Label text="Harga"/><TextField fx:id="hargaField" promptText="Contoh: 15000"/>
                <Button text="Simpan dan Lihat Detail" onAction="#simpan" styleClass="button-primary" maxWidth="Infinity"/>
                <Label fx:id="pesanLabel" wrapText="true" styleClass="error"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
